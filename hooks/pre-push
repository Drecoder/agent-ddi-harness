#!/bin/sh
# Generic pre-push hook for the DDI harness (manual install; `ddi install` writes the same thing
# with absolute paths filled in). Copy to .git/hooks/pre-push and set DDI_HOME to your clone of
# the harness. A non-zero exit stops the push; `git push --no-verify` skips every local hook.
: "${DDI_HOME:?set DDI_HOME to the directory of your agent-ddi-harness clone}"
PY="${DDI_PYTHON:-python3}"
PYTHONPATH="$DDI_HOME${PYTHONPATH:+:$PYTHONPATH}" exec "$PY" -m ddi pre-push --repo "$(git rev-parse --show-toplevel)"
