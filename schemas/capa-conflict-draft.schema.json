{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capa-conflict-draft.schema.json",
  "title": "A local CAPA or conflict draft: always a draft, always an unverified claim",
  "description": "The harness may only write status=draft, trust=unverified_claim, ci_provenance=null. Promotion to evidence happens outside the harness, from CI-signed results, by the owner.",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^ci_(?!provenance$)": false,
    "^(certified|signed|verified)": false
  },
  "required": [
    "schema",
    "fingerprint",
    "kind",
    "source",
    "subject",
    "status",
    "trust",
    "ci_provenance",
    "occurrences",
    "first_seen",
    "last_seen",
    "runs",
    "domain_context",
    "event",
    "conflicting_paths",
    "assumptions",
    "root_cause",
    "invariant_check",
    "correction",
    "preventive_action",
    "verification",
    "caveats",
    "sync_notes"
  ],
  "properties": {
    "schema": {
      "const": "ddi.capa_draft.v1"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "kind": {
      "enum": [
        "capa",
        "conflict"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "draft"
    },
    "trust": {
      "const": "unverified_claim"
    },
    "ci_provenance": {
      "const": null
    },
    "occurrences": {
      "type": "integer",
      "minimum": 1
    },
    "first_seen": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
    },
    "last_seen": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "domain_context": {
      "type": [
        "string",
        "array",
        "object",
        "null"
      ]
    },
    "event": {
      "type": [
        "string",
        "array",
        "object",
        "null"
      ]
    },
    "conflicting_paths": {
      "type": [
        "string",
        "array",
        "object",
        "null"
      ]
    },
    "assumptions": {
      "type": [
        "string",
        "array",
        "object",
        "null"
      ]
    },
    "root_cause": {
      "type": [
        "string",
        "array",
        "object",
        "null"
      ]
    },
    "invariant_check": {
      "type": [
        "string",
        "array",
        "object",
        "null"
      ]
    },
    "correction": {
      "type": [
        "string",
        "array",
        "object",
        "null"
      ]
    },
    "preventive_action": {
      "type": [
        "string",
        "array",
        "object",
        "null"
      ]
    },
    "verification": {
      "type": [
        "string",
        "array",
        "object",
        "null"
      ]
    },
    "caveats": {
      "type": [
        "string",
        "array",
        "object",
        "null"
      ]
    },
    "sync_notes": {
      "type": [
        "string",
        "array",
        "object",
        "null"
      ]
    }
  }
}
