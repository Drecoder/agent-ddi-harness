{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eep-catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "catalog",
    "rules"
  ],
  "properties": {
    "schema": {
      "const": "ddi.eep_rules.v1"
    },
    "catalog": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": true
    }
  }
}
